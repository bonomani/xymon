# Xymon compile-time settings for Darwin (Mac OS X)
#

OSDEF = -DDarwin

# NETLIBS: You may need to add -lresolv or similar to pick up network libraries
NETLIBS =

# Homebrew installs several optional dependencies under keg-specific prefixes,
# so add the common include/lib search paths for Darwin builds and configure tests.
HOMEBREW_PREFIX := $(shell brew --prefix 2>/dev/null)
HOMEBREW_OPT := $(HOMEBREW_PREFIX)/opt
HOMEBREW_SSL_PREFIX :=
HOMEBREW_CARES_PREFIX :=
HOMEBREW_RRDTOOL_PREFIX :=
HOMEBREW_INCLUDE_CANDIDATES :=
HOMEBREW_LIB_CANDIDATES :=
HOMEBREW_INCLUDE_DIRS :=
HOMEBREW_LIB_DIRS :=
HOMEBREW_CFLAGS :=
HOMEBREW_LDFLAGS :=
HOMEBREW_PKG_CONFIG_PATH :=
HOMEBREW_RRDTOOL_LIBDIRS_RAW :=
HOMEBREW_RRDTOOL_LIBDIRS :=
HOMEBREW_RRDTOOL_EXTRA_LIBS :=
HOMEBREW_RRDTOOL_LIBS :=
ifneq ($(HOMEBREW_PREFIX),)
ifneq ($(wildcard $(HOMEBREW_OPT)/openssl@3/include/openssl),)
HOMEBREW_SSL_PREFIX := $(HOMEBREW_OPT)/openssl@3
else ifneq ($(wildcard $(HOMEBREW_OPT)/openssl@1.1/include/openssl),)
HOMEBREW_SSL_PREFIX := $(HOMEBREW_OPT)/openssl@1.1
else ifneq ($(wildcard $(HOMEBREW_OPT)/openssl/include/openssl),)
HOMEBREW_SSL_PREFIX := $(HOMEBREW_OPT)/openssl
endif
ifneq ($(wildcard $(HOMEBREW_OPT)/c-ares/include/ares.h),)
HOMEBREW_CARES_PREFIX := $(HOMEBREW_OPT)/c-ares
else ifneq ($(wildcard $(HOMEBREW_OPT)/c-ares/include/ares/ares.h),)
HOMEBREW_CARES_PREFIX := $(HOMEBREW_OPT)/c-ares
endif
ifneq ($(wildcard $(HOMEBREW_OPT)/rrdtool/include/rrd.h),)
HOMEBREW_RRDTOOL_PREFIX := $(HOMEBREW_OPT)/rrdtool
endif
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_PREFIX)/include
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_OPT)/pcre/include
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_OPT)/openldap/include
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_OPT)/c-ares/include
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_OPT)/rrdtool/include
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_PREFIX)/lib
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_OPT)/pcre/lib
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_OPT)/openldap/lib
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_OPT)/c-ares/lib
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_OPT)/rrdtool/lib
ifneq ($(HOMEBREW_SSL_PREFIX),)
HOMEBREW_INCLUDE_CANDIDATES += $(HOMEBREW_SSL_PREFIX)/include
HOMEBREW_LIB_CANDIDATES += $(HOMEBREW_SSL_PREFIX)/lib
endif
HOMEBREW_INCLUDE_DIRS := $(foreach dir,$(HOMEBREW_INCLUDE_CANDIDATES),$(if $(wildcard $(dir)),$(dir)))
HOMEBREW_LIB_DIRS := $(foreach dir,$(HOMEBREW_LIB_CANDIDATES),$(if $(wildcard $(dir)),$(dir)))
HOMEBREW_CFLAGS := $(addprefix -I,$(HOMEBREW_INCLUDE_DIRS))
HOMEBREW_LDFLAGS := $(addprefix -L,$(HOMEBREW_LIB_DIRS))
HOMEBREW_PKG_CONFIG_PATH := $(HOMEBREW_PREFIX)/lib/pkgconfig:$(HOMEBREW_PREFIX)/share/pkgconfig
ifneq ($(HOMEBREW_RRDTOOL_PREFIX),)
HOMEBREW_PKG_CONFIG_PATH := $(HOMEBREW_RRDTOOL_PREFIX)/lib/pkgconfig:$(HOMEBREW_PKG_CONFIG_PATH)
endif
HOMEBREW_RRDTOOL_LIBDIRS_RAW := $(shell if [ -n "$(HOMEBREW_PKG_CONFIG_PATH)" ] && command -v pkg-config >/dev/null 2>&1; then PKG_CONFIG_PATH="$(HOMEBREW_PKG_CONFIG_PATH):$$PKG_CONFIG_PATH" pkg-config --libs-only-L librrd 2>/dev/null; fi)
HOMEBREW_RRDTOOL_LIBDIRS := $(if $(strip $(HOMEBREW_RRDTOOL_LIBDIRS_RAW)),$(strip $(HOMEBREW_RRDTOOL_LIBDIRS_RAW)),$(if $(HOMEBREW_RRDTOOL_PREFIX),-L$(HOMEBREW_RRDTOOL_PREFIX)/lib))
HOMEBREW_RRDTOOL_EXTRA_LIBS := $(strip $(shell if [ -n "$(HOMEBREW_PKG_CONFIG_PATH)" ] && command -v pkg-config >/dev/null 2>&1; then PKG_CONFIG_PATH="$(HOMEBREW_PKG_CONFIG_PATH):$$PKG_CONFIG_PATH" pkg-config --libs librrd 2>/dev/null | sed -e 's/[[:space:]]-L[^[:space:]]*//g' -e 's/[[:space:]]-lrrd\([[:space:]]\|$$\)/ /g' -e 's/^ *//' -e 's/  */ /g' -e 's/ *$$//'; fi))
HOMEBREW_RRDTOOL_LIBS := $(strip $(HOMEBREW_RRDTOOL_LIBDIRS) -lrrd $(HOMEBREW_RRDTOOL_EXTRA_LIBS))
endif

ifeq ($(strip $(OSSLINC)),)
ifneq ($(HOMEBREW_SSL_PREFIX),)
OSSLINC = -I$(HOMEBREW_SSL_PREFIX)/include
endif
endif
ifeq ($(strip $(OSSLLIB)),)
ifneq ($(HOMEBREW_SSL_PREFIX),)
OSSLLIB = -L$(HOMEBREW_SSL_PREFIX)/lib
endif
endif

ifeq ($(strip $(CARESINC)),)
ifneq ($(HOMEBREW_CARES_PREFIX),)
CARESINC = -I$(HOMEBREW_CARES_PREFIX)/include
endif
endif
ifeq ($(strip $(CARESLIB)),)
ifneq ($(HOMEBREW_CARES_PREFIX),)
CARESLIB = -L$(HOMEBREW_CARES_PREFIX)/lib
endif
endif

ifeq ($(strip $(RRDINC)),)
ifneq ($(HOMEBREW_RRDTOOL_PREFIX),)
RRDINC = -I$(HOMEBREW_RRDTOOL_PREFIX)/include
endif
endif
ifeq ($(strip $(RRDLIB)),)
ifneq ($(HOMEBREW_RRDTOOL_LIBDIRS),)
RRDLIB = $(HOMEBREW_RRDTOOL_LIBDIRS)
endif
endif
ifeq ($(strip $(PNGLIB)),)
ifneq ($(HOMEBREW_RRDTOOL_EXTRA_LIBS),)
PNGLIB = $(HOMEBREW_RRDTOOL_EXTRA_LIBS)
endif
endif

ifneq ($(strip $(CARESLIBS)),)
ifneq ($(HOMEBREW_CARES_PREFIX),)
ifeq ($(findstring -L,$(CARESLIBS)),)
CARESLIBS = -L$(HOMEBREW_CARES_PREFIX)/lib -lcares
endif
endif
endif

ifeq ($(strip $(RRDINCDIR)),)
ifneq ($(HOMEBREW_RRDTOOL_PREFIX),)
RRDINCDIR = -I$(HOMEBREW_RRDTOOL_PREFIX)/include
endif
endif
ifneq ($(strip $(RRDLIBS)),)
ifneq ($(HOMEBREW_RRDTOOL_LIBS),)
ifeq ($(findstring -L,$(RRDLIBS)),)
RRDLIBS = $(HOMEBREW_RRDTOOL_LIBS)
endif
endif
endif

ifneq ($(strip $(SSLLIBS)),)
ifneq ($(HOMEBREW_SSL_PREFIX),)
ifeq ($(strip $(SSLINCDIR)),)
SSLINCDIR = -I$(HOMEBREW_SSL_PREFIX)/include
endif
ifeq ($(findstring -L,$(SSLLIBS)),)
SSLLIBS = -L$(HOMEBREW_SSL_PREFIX)/lib -lssl -lcrypto
RPATHVAL += $(HOMEBREW_SSL_PREFIX)/lib
endif
endif
endif

# Keep Homebrew search paths in the final link step too. The legacy configure
# probes rely on CFLAGS carrying these paths, but the real subdir links use
# LDFLAGS and can miss keg-only formulas such as rrdtool otherwise.
LDFLAGS += $(HOMEBREW_LDFLAGS)

# Compile flags for normal build
# On macOS, plain "gcc" is typically Apple's Clang driver. Prefer a real
# Homebrew GNU compiler when available, and otherwise use Clang explicitly.
HOMEBREW_GCC := $(shell \
	for cc in gcc-15 gcc-14 gcc-13 gcc-12 gcc-11; do \
		if command -v $$cc >/dev/null 2>&1; then \
			command -v $$cc; \
			exit 0; \
		fi; \
	done; \
	exit 0)
ifeq ($(origin CC), default)
CC := $(if $(strip $(HOMEBREW_GCC)),$(HOMEBREW_GCC),clang)
endif
CC_BASENAME := $(notdir $(CC))
IS_GCC := $(findstring gcc,$(CC_BASENAME))
BASE_CFLAGS = -g -O -Wall -Wno-unused -D_REENTRANT -DBIND_8_COMPAT=1 $(LFSDEF) $(OSDEF)
CFLAGS = $(BASE_CFLAGS) $(HOMEBREW_CFLAGS)
ifneq ($(IS_GCC),)
	CFLAGS += -Wno-pointer-sign
endif


# Compile flags for debugging
# CFLAGS = -g -DDEBUG -D_REENTRANT -DBIND_8_COMPAT=1 $(LFSDEF) $(OSDEF)

# Extra environment settings for runtime stuff.
# E.g. RUNTIMEDEFS="LD_LIBRARY_PATH=\"/opt/lib\"" to use 
# runtime libraries located in /opt/lib
RUNTIMEDEFS = 

# Mail program: This must support "CMD -s SUBJECT ADDRESS" to send out a mail with a subject
# Typically, this will be "mail" or "mailx"
MAILPROGRAM="mail"
