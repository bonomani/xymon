#!/bin/sh
#
# Run every executable regression test under tests/. Exit 0 if at least one
# test passed and none failed; 1 if any failed; 77 if every test skipped
# (suite verified nothing -- see the all-skip note near the end). Individual
# tests follow the tests/README.md contract: exit 0 = pass, 77 = skip,
# anything else = fail.
#
# Output adapts automatically: GitHub Actions log annotations when run under
# Actions ($GITHUB_ACTIONS=true), plain human-readable output otherwise. Both
# the CI workflow and a developer run the same code path.
#
# Usage: ./tests/testsuite        (from anywhere; resolves the repo root itself)
#        make test
#
set -u

# Resolve the repo root from this script's own location, so it works from any cwd.
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 2
cd "$root" || exit 2

if [ "${GITHUB_ACTIONS:-}" = "true" ]; then gh=1; else gh=0; fi

# A test that could only verify part of what it covers -- no compiler for the
# behavioural half, nothing built to drive -- reports through pass_partial
# (lib/assert.sh). That still exits 0, because what ran did hold, so the
# runner cannot tell those apart by exit status; each one records itself here
# instead. Counting them separately is the point: otherwise a source-only
# fallback and a full behavioural run both land in "passed" and the number
# claims more than the suite checked.
partial_log=$(mktemp "${TMPDIR:-/tmp}/xymon-testsuite.$$.XXXXXX") || exit 2
trap 'rm -f "$partial_log"' EXIT
trap 'rm -f "$partial_log"; exit 130' INT
trap 'rm -f "$partial_log"; exit 143' TERM
XYMON_TESTS_PARTIAL_LOG=$partial_log
export XYMON_TESTS_PARTIAL_LOG

# Every test is bash by contract (tests/README.md); this runner stays POSIX sh
# so it can deliver the skip below even where bash is absent. Without this
# check, each test's exec would fail with rc=127 and count as FAIL -- but a
# missing interpreter is a missing host dependency, not a regression, so skip
# the whole suite the same way an individual test skips a missing tool.
if ! command -v bash >/dev/null 2>&1; then
	printf 'SKIP: bash not found -- every test requires bash (see tests/README.md)\n' >&2
	exit 77
fi

group() {
	if [ "$gh" = 1 ]; then printf '::group::%s\n' "$1"; else printf '\n----- %s -----\n' "$1"; fi
}
endgroup() {
	if [ "$gh" = 1 ]; then printf '::endgroup::\n'; fi
}
errline() {
	if [ "$gh" = 1 ]; then printf '::error::%s\n' "$1"; else printf 'FAIL: %s\n' "$1"; fi
}

# Discover executable *.sh under tests/. Sourced helpers (tests/lib/) and shared
# data (tests/fixtures/) are not +x, so they are not picked up -- see README.
# This runner has no .sh extension, so it never discovers itself.
#
# The explicit lib/ and fixtures/ excludes back up the exec-bit rule on
# checkouts where every file reads as executable (FAT/NTFS mounts, trees with
# core.fileMode=false): there, a shebang-less helper like lib/assert.sh would
# otherwise be discovered, run as sh, define its functions, exit 0 -- and count
# as a pass that verified nothing.
tests=$(find tests -type f -name '*.sh' -perm -u+x \
	! -path 'tests/lib/*' ! -path 'tests/fixtures/*' | sort)

# Zero discovered tests is a failure, not a quiet success: the runner ships
# alongside the tests, so an empty result means something is wrong -- lost
# executable bits, a packaging omission, or a broken discovery path -- and
# treating it as green would let CI go green while running nothing.
if [ -z "$tests" ]; then
	errline "No executable tests found under tests/ (lost +x bit, packaging omission, or broken discovery)"
	exit 1
fi

# provided_areas VARIANT -- the test areas whose subject this build actually
# contains. One table, two uses:
#
#   filter -- a test in an area this build does not contain has nothing here to
#     exercise, so it is skipped as not applicable. That is what stops a client
#     leg compiling server web-CGI code (and writing lib/libxymon*.a into its
#     tree as a side effect, which is what made the suite non-idempotent).
#   floor  -- inside the areas it does contain, every test must run. A skip
#     there is a coverage regression: a test stopped exercising something this
#     build has.
#
# The filter is deliberately not the only way in. A test that calls require_bin
# runs regardless of its area, because the manifest in lib/assert.sh knows which
# variants ship which binary and the directory does not: tests/server/ holds
# tests that drive client/xymongrep and client/xymond_client, and those must
# keep running in a client leg. Area and driver are different questions -- the
# directory answers the first, require_bin the second.
provided_areas() {
	case $1 in
		server)      echo 'buildsystem packaging common client localclient server web xymonnet xymond rrd' ;;
		localclient) echo 'buildsystem packaging common client localclient' ;;
		client)      echo 'buildsystem packaging common client' ;;
	esac
}

# Every variant the table knows. Named once, here, next to the rows it indexes:
# any second copy is a list that can fall behind this one.
known_variants='server localclient client'

# A variant matching no row above leaves every area unprovided, so every test
# whose area the table would have answered for is filtered instead, each with a
# fabricated reason naming an area this build was never asked about -- and with
# XYMON_TESTS_STRICT the floor's required set is empty too, so it passes a run
# in which almost nothing executed. lib/assert.sh's check_variant refuses
# exactly this, but only for tests that reach require_bin. The filter decides
# first and for everything, so the refusal belongs here too.
if [ -n "${XYMON_VARIANT:-}" ] && [ -z "$(provided_areas "$XYMON_VARIANT")" ]; then
	errline "XYMON_VARIANT='${XYMON_VARIANT}' is not a known variant (${known_variants}) -- likely a CI-matrix typo; refusing to skip every test silently"
	exit 1
fi

# strict_mode -- true when the caller declared this environment complete.
#
# Not an equality test against "1": XYMON_TESTS_STRICT is set in YAML, where
# true/yes/on are the natural spellings for a boolean, and any of them against
# `= 1` reads as "not set" -- the enforcement the variable exists to switch on
# is silently off and the leg still reports success. Accept the spellings, and
# treat an unrecognised one as an error rather than as off, because guessing
# "off" is the direction that goes quietly green.
strict_mode() {
	case "${XYMON_TESTS_STRICT:-}" in
		''|0|false|no|off) return 1 ;;
		1|true|yes|on)     return 0 ;;
		*) errline "XYMON_TESTS_STRICT='${XYMON_TESTS_STRICT}' is neither on (1/true/yes/on) nor off (0/false/no/off) -- refusing to guess which enforcement you meant"
		   exit 1 ;;
	esac
}

# not_applicable TESTPATH -- true when this variant contains neither the test's
# area nor a build product it asks for.
not_applicable() {
	[ -n "${XYMON_VARIANT:-}" ] || return 1
	na_area=${1#tests/}; na_area=${na_area%%/*}
	case " $(provided_areas "$XYMON_VARIANT") " in
		*" $na_area "*) return 1 ;;
	esac
	# A call, not a mention. Matching the bare word anywhere in the file let
	# tests/web/html-log-custom-graphs.sh through on a comment that merely
	# names require_bin -- so a test the area filter was right about ran
	# anyway and then skipped on its own precondition, reporting a different
	# reason for the same fact. Anchor on the call.
	grep -qE '^[[:space:]]*require_bin[[:space:]]' "$1" 2>/dev/null && return 1
	# An area no row mentions at all. The table cannot say this build lacks the
	# subject, so the runner must not claim it does: run the test and let its
	# own preconditions answer. Filtering here instead would be a silent skip
	# the coverage floor cannot see, because a filtered test never reaches
	# $skipped_in -- the one outcome this whole table exists to prevent.
	case "$known_areas" in *" $na_area "*) ;; *) return 1 ;; esac
	return 0
}

# Every area any variant declares, composed from known_variants so a variant
# added to the table above is not silently missing here.
known_areas=''
for v in $known_variants; do known_areas="$known_areas $(provided_areas "$v")"; done
known_areas=" $known_areas "

# Which areas on disk the table has never heard of. Running them (above) is the
# safe direction, but it is still a table omission, so it is reported: a note on
# a developer run, and a hard failure under XYMON_TESTS_STRICT, where CI has
# declared this environment -- and therefore this table -- complete. The failure
# is raised at the end, next to the coverage floor, so a run that trips it still
# reports every real test result first instead of aborting on a directory name.
unknown_areas=''
while IFS= read -r t; do
	[ -n "$t" ] || continue
	a=${t#tests/}; a=${a%%/*}
	case "$known_areas" in *" $a "*) continue ;; esac
	case " $unknown_areas " in *" $a "*) continue ;; esac
	unknown_areas="${unknown_areas}${a} "
done <<EOF
$tests
EOF
[ -z "$unknown_areas" ] || printf 'NOTE: test area(s) in no provided_areas row: %s -- running them unfiltered; add them to the table in tests/testsuite\n' "${unknown_areas% }"

pass=0; skip=0; fail=0; failed=''; skipped_in=''
# Iterate line-by-line rather than `for t in $tests`: unquoted word-splitting
# breaks on any path containing a space (find emits newline-separated paths, but
# the default IFS splits on spaces and tabs too). The here-doc keeps the loop in
# this shell -- not a `| while` subshell -- so the counters below survive it.
while IFS= read -r t; do
	[ -n "$t" ] || continue
	group "$t"
	if not_applicable "$t"; then
		printf 'SKIP: the %s build contains neither the %s area nor a build product this test asks for\n' \
			"$XYMON_VARIANT" "$na_area" >&2
		printf '  skip (rc=77)\n'
		skip=$((skip + 1))
		endgroup
		continue
	fi
	"./$t"
	rc=$?
	case $rc in
		0)  printf '  ok\n';           pass=$((pass + 1)) ;;
		77) printf '  skip (rc=77)\n'; skip=$((skip + 1))
		    a=${t#tests/}; a=${a%%/*}
		    skipped_in="${skipped_in}${a} ${t}
" ;;
		*)  errline "$t FAILED (rc=$rc)"
		    fail=$((fail + 1))
		    failed="${failed}  - ${t} (rc=${rc})
" ;;
	esac
	endgroup
done <<EOF
$tests
EOF

# Count without wc/awk so the runner keeps depending only on the shell.
partial=0
while IFS= read -r _; do partial=$((partial + 1)); done <"$partial_log"
# pass counted every exit 0, partials included; report them as disjoint so the
# four numbers add up to the tests discovered.
pass=$((pass - partial))

printf '\n----- summary -----\n'
printf 'passed:  %d\n' "$pass"
printf 'partial: %d\n' "$partial"
printf 'skipped: %d\n' "$skip"
printf 'failed:  %d\n' "$fail"

if [ "$partial" -gt 0 ]; then
	printf '\npartial tests (verified less than they cover):\n'
	while IFS= read -r p; do printf '  - %s\n' "$p"; done <"$partial_log"
fi

if [ "$fail" -gt 0 ]; then
	printf '\nfailing tests:\n%s' "$failed"
	exit 1
fi

# A complete environment must also have a complete table -- see the note where
# unknown_areas is collected. Raised here, after every test has run and been
# reported, because an undeclared directory is a bookkeeping omission and not a
# reason to withhold the results.
if [ -n "$unknown_areas" ] && strict_mode; then
	errline "test area(s) named in no provided_areas row: ${unknown_areas% } -- add them to the table in tests/testsuite so this build can say whether it contains them"
	exit 1
fi

# Coverage floor. Only in an environment that declares itself complete: CI
# exports XYMON_TESTS_STRICT after installing the dependency list and building
# the variant, so anything still missing there is the image or the build, not
# the host. A developer box declares nothing and is never held to this.
if strict_mode && [ -n "${XYMON_VARIANT:-}" ]; then
	required=" $(provided_areas "$XYMON_VARIANT") "
	breached=''
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		area=${line%% *}
		case $required in
			*" $area "*) breached="${breached}  - ${line#* }
" ;;
		esac
	done <<EOF2
$skipped_in
EOF2
	if [ -n "$breached" ]; then
		errline "coverage floor: the ${XYMON_VARIANT} build produces these areas, so every test in them must run -- these skipped"
		printf '%s' "$breached" >&2
		exit 1
	fi
fi


# Every discovered test skipped means the suite exercised nothing: in a tree
# that ships tests/ without the code those tests guard (a packaging omission,
# or an autopkgtest run against an installed package with no source), each test
# hits an absent precondition and skips. Reporting exit 0 here is a false green
# -- CI/autopkgtest would record a pass while nothing was actually verified.
# Propagate the all-skip upward as a skip (exit 77, the same convention the
# individual tests use; see skip() in tests/lib/assert.sh) so the layer above
# sees "skipped", not "passed". The empty-discovery case already exited above,
# so reaching here with pass=0, partial=0 and fail=0 means skip>0. A partial
# did verify something, so it keeps the suite out of the all-skip case.
if [ $((pass + partial)) -eq 0 ]; then
	printf 'SKIP: every test skipped -- suite verified nothing (tests/ shipped without the code under test?)\n' >&2
	exit 77
fi
exit 0
